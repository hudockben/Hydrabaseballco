# ---- Hydra Prospector environment variables ----
# Copy real values into Vercel (Project -> Settings -> Environment Variables).
# NEVER commit the real values.

# Neon Postgres connection string (use the "pooled" connection string from Neon).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Password required to reach the /admin area.
ADMIN_PASSWORD="choose-a-strong-password"

# Long random string used to sign admin login cookies.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: free key from https://api.data.gov/signup/ for higher College
# Scorecard rate limits. Falls back to the shared DEMO_KEY if unset.
# SCORECARD_API_KEY=""

# ---- Online store (Stripe) ----
# Stripe Dashboard -> Developers -> API keys. Use the test keys (sk_test_/pk_test_)
# until you're ready to take real money, then swap in the live ones.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe Dashboard -> Developers -> Webhooks -> add endpoint
#   https://<your-domain>/api/stripe/webhook
#   events: checkout.session.completed, checkout.session.async_payment_succeeded
# then copy its signing secret here.
# STRIPE_WEBHOOK_SECRET="whsec_..."
